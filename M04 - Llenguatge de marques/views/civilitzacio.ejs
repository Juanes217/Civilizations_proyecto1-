<%- include('partials/header') %>

<main class="container">
    <h1 class="fade-in">Estat de la Civilització</h1>
    <p class="subtitle">Gestió de recursos del teu regne medieval.</p>

    <div class="recursos-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 30px;">
        <div class="table-container" style="padding: 20px;">
            <img src="/img/fusta.png" alt="Fusta" style="width: 50px;">
            <p>Fusta: <strong><%= stats.fusta %></strong></p>
        </div>
        <div class="table-container" style="padding: 20px;">
            <img src="/img/ferro.png" alt="Ferro" style="width: 50px;">
            <p>Ferro: <strong><%= stats.ferro %></strong></p>
        </div>
        <div class="table-container" style="padding: 20px;">
            <img src="/img/menjar.png" alt="Menjar" style="width: 50px;">
            <p>Menjar: <strong><%= stats.menjar %></strong></p>
        </div>
        <div class="table-container" style="padding: 20px;">
            <img src="/img/maná.png" alt="Manà" style="width: 50px;">
            <p>Manà: <strong><%= stats.mana %></strong></p>
        </div>
    </div>
</main>

<%- include('partials/footer') %> 