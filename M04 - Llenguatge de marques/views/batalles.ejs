<%- include('partials/header') %>

<main class="container">
    <h1>Historial de Batalles</h1>
    <p class="subtitle">Consulta els detalls dels teus últims enfrontaments militars.</p>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Data</th>
                    <th>Enemic</th>
                    <th>Resultat</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof batalles !== 'undefined') { %>
                    <% batalles.forEach(b => { %>
                        <tr>
                            <td><strong>#<%= b.id %></strong></td>
                            <td><%= b.data %></td>
                            <td><%= b.enemic || 'Desconegut' %></td>
                            <td>
                                <% if (b.resultat === 'Victòria') { %>
                                    <span style="color: #28a745; font-weight: bold;">Victòria</span>
                                <% } else { %>
                                    <span style="color: #dc3545; font-weight: bold;">Derrota</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</main>

<%- include('partials/footer') %>