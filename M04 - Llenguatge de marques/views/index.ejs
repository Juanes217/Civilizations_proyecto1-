<%- include('partials/header') %>

<main class="hero">
    <section class="portada">
        <h1 class="fade-in">Benvingut al Regne</h1>
        <p>Gestiona els teus recursos i conquereix territoris.</p>
        <div class="captures">
            <img src="/img/screenshot1.png" alt="Joc" class="img-preview">
        </div>
    </section>

    <section class="ultimes-batalles">
        <h2>Últimes 2 Batalles</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Data</th>
                    <th>Resultat</th>
                </tr>
            </thead>
            <tbody>
                <% batalles.forEach(batalla => { %>
                    <tr>
                        <td>#<%= batalla.id %></td>
                        <td><%= batalla.data %></td>
                        <td><%= batalla.resultat %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </section>
</main>

<%- include('partials/footer') %>