<%- include('partials/header') %>

<main class="container"> 
    <section class="hero-section">
        <h1 class="fade-in">Benvingut al Regne</h1>
        <p class="subtitle">Gestiona els teus recursos i conquereix territoris.</p>
        
        </section>

    <section class="batalles-section">
        <h2>Últimes 2 Batalles</h2>
        
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Data</th>
                        <th>Resultat</th>
                    </tr>
                </thead>
                <tbody>
                    <% batalles.forEach(batalla => { %>
                        <tr>
                            <td>#<%= batalla.id %></td>
                            <td><%= batalla.data %></td>
                            <td><%= batalla.resultat %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
</main>

<%- include('partials/footer') %>